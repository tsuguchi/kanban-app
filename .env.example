# このファイルを .env.local にコピーして使う（.env.local は Git に入らない）
#
# 下の値は Firebase Emulator（npm run emulators）で開発するための設定で、このまま使える。
# demo- で始まるプロジェクト ID は Emulator 専用で、本番の Firebase には接続しない。
#
# 本番の Firebase に接続して試すときは、Firebase コンソールの「プロジェクトの設定」→「マイアプリ」の値に
# 置き換え、VITE_USE_EMULATOR を false にする
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-kanban.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-kanban
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_EMULATOR=true
